{
  "name": "milink-landings",
  "compatibility_date": "2026-09-18",
  "main": "src/index.js",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "*.milink.shop/*", "zone_name": "milink.shop" },
    { "pattern": "milink.shop/*", "zone_name": "milink.shop" }
  ]
}
